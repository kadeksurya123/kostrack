# Supabase Public Configuration (Client & Server)
# Dapatkan dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Supabase Service Role Key (Server-side only for elevated admin operations)
# PENTING: JANGAN PERNAH gunakan prefix NEXT_PUBLIC_ untuk service role key!
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
